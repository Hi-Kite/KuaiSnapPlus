<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scrollview"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 头部区域  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_launcher" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快怼+"
                        android:textColor="#1A237E"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="对快对进行一些优化和破解"
                        android:textColor="#546E7A"
                        android:textSize="14sp"
                        android:paddingTop="4dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 一言 -->
        <TextView
            android:id="@+id/hitokoto_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="永远相信美好的事情即将发生..."
            android:textColor="#78909C"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="16dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/quote_background"
            android:minWidth="120dp" />

        <!-- 设备信息标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设备信息"
            android:textColor="#1A237E"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <!-- 设备信息卡片：添加水波纹 -->
        <LinearLayout
            android:id="@+id/card_device_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_background_with_ripple"
            android:orientation="vertical"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">

            <!-- 安卓版本 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="安卓版本:"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_android_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#263238"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- SDK等级 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SDK等级:"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_sdk_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#263238"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 安卓ID -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="安卓ID:"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_android_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#263238"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 品牌 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="品牌:"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#263238"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 型号 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="型号:"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#263238"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- SKU -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SKU:"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_sku"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#263238"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 构建种类 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="构建种类:"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_build_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#263238"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- 构建指纹 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="构建指纹:"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_build_fingerprint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:textColor="#263238"
                    android:textSize="14sp"
                    android:gravity="end"
                    android:maxLines="3"
                    android:ellipsize="none"
                    android:singleLine="false"/>
            </LinearLayout>

            <!-- 模块激活状态 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="模块状态:"
                    android:textColor="#546E7A"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_module_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#4CAF50"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 支持信息标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="支持信息"
            android:textColor="#1A237E"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <!-- 支持信息卡片：添加水波纹 -->
        <LinearLayout
            android:id="@+id/card_support_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_background_with_ripple"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <!-- 快对图标：添加水波纹 -->
            <ImageView
                android:id="@+id/icon_kuaidui"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_kuaidui"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"/>

            <!-- 应用名称 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="快对"
                android:textColor="#263238"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingTop="16dp"/>

            <!-- 包名和版本 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="com.kuaiduizuoye.scan · v6.77.0 / v7.7.0"
                android:textColor="#546E7A"
                android:textSize="14sp"
                android:paddingTop="8dp"/>

            <!-- 功能区域 -->
            <LinearLayout
                android:id="@+id/features_kuaidui"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ 解锁本地VIP会员"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:paddingBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ 去除所有广告"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:paddingBottom="4dp"/>
				
				<TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ 支持直接保存解析页图片"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:paddingBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="✓ 去除截屏限制"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:gravity="center"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 关于作者标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="关于作者"
            android:textColor="#1A237E"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="16dp"/>

        <!-- 关于作者卡片：添加水波纹 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/card_background_with_ripple"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <!-- 作者头像：添加水波纹 -->
            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/author_avatar"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"/>

            <!-- 作者名字 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kite"
                android:textColor="#263238"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingTop="16dp"/>

            <!-- 作者简介 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Android开发者 | Xposed模块开发者 | 逆向爱好者"
                android:textColor="#546E7A"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingTop="8dp"/>

            <!-- 问题反馈入口 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐛 github.com/Hi-Kite/KuaiSnapPlus/issues"
                android:textColor="#455A64"
                android:textSize="14sp"
                android:paddingTop="16dp"/>

            <!-- 官网链接 -->
            <TextView
                android:id="@+id/tv_website"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 hi-kite.github.io"
                android:textColor="#2196F3"
                android:textSize="14sp"
                android:paddingTop="8dp"/>
        </LinearLayout>

        <!-- 底部信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="快怼+ v1.3.0"
                android:textColor="#78909C"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KuaiSnapPlus · 原项目 KuaiSnap 的 fork"
                android:textColor="#78909C"
                android:textSize="11sp"
                android:paddingTop="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="严禁用作商业用途，违者必究"
                android:textColor="#78909C"
                android:textSize="11sp"
                android:paddingTop="4dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
